  "narrative": {
    "northStar": "The SYSTORY People Desk",
    "overview": "SYSTORY HRMS presents everyday people operations as clear, dependable work: administrators can scan and act on structured records, while employees can complete common self-service tasks without losing the human context. The visual system is professional and practical, with a friendly tone carried by readable Lao-first typography, clear status language, and consistent interaction states. Keep the interface minimal and trustworthy. Use decoration only when it clarifies hierarchy or state; preserve the existing palette, component behavior, and responsive patterns rather than introducing a new visual direction.",
    "keyCharacteristics": ["Professional, clear, friendly, and trustworthy.", "Practical information hierarchy for frequent HR workflows.", "Lao-first typography and localization, with English supported.", "Restrained surfaces, consistent controls, and status that is never communicated by color alone."],
    "rules": [
      { "name": "The Lao Leading Rule", "body": "Keep Lao text at the implemented leading or roomier; do not compress line-height to fit a layout.", "section": "typography" },
      { "name": "The Bordered Content Surface Rule", "body": "Pair card and popover shadows with a visible border; use overlay contrast and elevation to separate dialogs and drawers.", "section": "elevation" }
    ],
    "dos": ["Do preserve SYSTORY Teal, Cool Mist, the existing type family, and the established component shapes.", "Do keep color roles semantic and status labels explicit in both supported languages.", "Do retain visible keyboard focus and the reduced-motion behavior already provided.", "Do keep operational pages structured, readable, and efficient for repeated daily use.", "Do preserve the mobile drawer, card-based table adaptation, and print-specific report behavior."],
    "donts": ["Don't introduce a new visual identity, inconsistent colors, excessive decoration, or unnecessary animation.", "Don't communicate a status with color alone.", "Don't compress Lao line-height or clip tone marks to save space.", "Don't use shadows without the established border treatment or add nested card frames.", "Don't imply legal compliance, customer proof, or product outcomes that have not been established."]
