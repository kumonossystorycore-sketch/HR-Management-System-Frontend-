# Where the browser reaches the API (Phase 4–5 backend). In production put both behind one
# domain (e.g. nginx: / → web, /api → API) and set this to https://hr.your-company.la/api/v1.
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Optional line under the sign-in form, e.g. "ຝ່າຍບຸກຄະລາກອນ +856 20 0000 0000". Leave empty to hide it.
NEXT_PUBLIC_SUPPORT_CONTACT=""
